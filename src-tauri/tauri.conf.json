{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimir",
  "version": "1.0.0",
  "identifier": "com.madhavc21.buddy",
  "build": {  
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "console",
        "title": "Mimir",
        "width": 680,
        "height": 520,
        "resizable": true,
        "visible": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "url": "console.html"
      },
      {
        "label": "main",
        "title": "Mimir",
        "width": 260,
        "height": 380,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/mimir_snippets/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/capture",
      "binaries/chat"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}